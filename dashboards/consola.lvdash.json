{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Resumen del día",
      "queryLines": [
        "SELECT ",
        "(SELECT COUNT(*) FROM proyecto.equipo3_gold.vessel_daily_track WHERE day = :fecha) AS buques, ",
        "(SELECT SUM(positions) FROM proyecto.equipo3_gold.vessel_daily_track WHERE day = :fecha) AS posiciones, ",
        "(SELECT SUM(CASE WHEN metric = 'aprobadas' THEN rows END) / SUM(CASE WHEN metric = 'aprobadas' THEN total_rows END) ",
        "FROM proyecto.equipo3_silver.quality_metrics WHERE day = :fecha) AS pct_aprobadas, ",
        "(SELECT COUNT(DISTINCT port_index) FROM proyecto.equipo3_gold.port_presence WHERE day = :fecha) AS puertos "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_cells",
      "displayName": "Tráfico por celda",
      "queryLines": [
        "SELECT h3_cell, ",
        "ROUND(AVG(center_lat), 5) AS center_lat, ",
        "ROUND(AVG(center_lon), 5) AS center_lon, ",
        "SUM(positions) AS positions, ",
        "MAX(vessels) AS max_vessels_in_hour, ",
        "ROUND(AVG(avg_sog), 2) AS avg_sog ",
        "FROM proyecto.equipo3_gold.traffic_cell_hourly ",
        "WHERE day = :fecha ",
        "GROUP BY h3_cell ",
        "ORDER BY positions DESC ",
        "LIMIT 5000 "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_hours",
      "displayName": "Tráfico por hora",
      "queryLines": [
        "SELECT hour, SUM(positions) AS positions, SUM(vessels) AS vessel_cells ",
        "FROM proyecto.equipo3_gold.traffic_cell_hourly ",
        "WHERE day = :fecha ",
        "GROUP BY hour ",
        "ORDER BY hour "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_ports",
      "displayName": "Ranking de puertos",
      "queryLines": [
        "SELECT port_name, ",
        "COUNT(DISTINCT MMSI) AS vessels, ",
        "COUNT(DISTINCT CASE WHEN stopped_positions > 0 THEN MMSI END) AS vessels_stopped, ",
        "ROUND(SUM(minutes_in_port) / 60, 1) AS vessel_hours_in_port ",
        "FROM proyecto.equipo3_gold.port_presence ",
        "WHERE day = :fecha ",
        "GROUP BY port_name ",
        "ORDER BY vessels DESC ",
        "LIMIT 15 "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_in_port",
      "displayName": "Buques en puerto",
      "queryLines": [
        "SELECT p.port_name, p.MMSI, p.vessel_name, ",
        "COALESCE(t.vessel_category, 'Sin tipo') AS vessel_category, ",
        "p.arrival_ts, p.departure_ts, p.minutes_in_port, p.stopped_positions ",
        "FROM proyecto.equipo3_gold.port_presence AS p ",
        "LEFT JOIN proyecto.equipo3_raw.vessel_type_catalog AS t ON t.VesselType = p.vessel_type ",
        "WHERE p.day = :fecha ",
        "ORDER BY p.port_name, p.arrival_ts "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_anomalies",
      "displayName": "Anomalías del día",
      "queryLines": [
        "SELECT a.MMSI, a.vessel_name, ",
        "COALESCE(t.vessel_category, 'Sin tipo') AS vessel_category, ",
        "ROUND(a.anomaly_score, 4) AS anomaly_score, ",
        "a.rule_flag, a.avg_sog, a.max_sog, a.max_implied_knots, a.distance_km, a.model_version ",
        "FROM proyecto.equipo3_gold.vessel_speed_anomalies AS a ",
        "LEFT JOIN proyecto.equipo3_raw.vessel_type_catalog AS t ON t.VesselType = a.vessel_type ",
        "WHERE a.day = :fecha AND a.is_anomaly ",
        "ORDER BY a.anomaly_score DESC "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Calidad del día",
      "queryLines": [
        "SELECT metric, category, SUM(rows) AS rows, SUM(rows) / SUM(total_rows) AS pct ",
        "FROM proyecto.equipo3_silver.quality_metrics ",
        "WHERE day = :fecha AND category <> 'resumen' ",
        "GROUP BY metric, category ",
        "ORDER BY rows DESC "
      ],
      "parameters": [
        {
          "displayName": "fecha",
          "keyword": "fecha",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2023-06-08"
                }
              ]
            }
          }
        }
      ]
    }
  ],
